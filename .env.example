# =================================================================
# FysiSteps Environment Configuration
# =================================================================

# MongoDB Atlas Connection URI (Required for persistent storage)
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority
# Make sure your IP address is whitelisted in Network Access in MongoDB Atlas.
MONGODB_URI="YOUR_MONGODB_ATLAS_CONNECTION_STRING"

# JWT Secret for signing authentication tokens
# REQUIRED in production. For local dev, a fallback is provided.
JWT_SECRET=

# Optional Admin API key for platform administrative tasks (creating/deleting orgs & rewards)
ADMIN_API_KEY=

# Optional Gemini API key for server-side AI features
GEMINI_API_KEY=

# Node Environment ('development' or 'production')
NODE_ENV=development
